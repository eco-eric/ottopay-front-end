# Copy to .env for local development. Values: Supabase dashboard > Project Settings > API.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# The marketing site uses the same Supabase project as the app (ottopay).
VITE_SUPABASE_PUBLISHABLE_KEY=<anon key>
# Optional: where sign-in and sign-up buttons send people. Defaults to https://app.ottopay.pro.
# VITE_APP_URL=https://app.ottopay.pro
