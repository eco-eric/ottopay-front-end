---
const links = [
  { href: '/features', label: 'Features' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/why-us', label: 'Why OttoPay' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="nav">
  <div class="container nav-inner">
    <a class="brand" href="/" aria-label="OttoPay home">
      <img src="/img/otto.png" alt="" width="54" height="28" />
      <span>OttoPay</span>
    </a>

    <nav class="links" aria-label="Main">
      {links.map((l) => (
        <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>

    <div class="actions">
      <a class="login" href="https://app.ottopay.pro/auth">Log in</a>
      <a class="btn btn-primary btn-nav" href="https://app.ottopay.pro/auth?mode=signup">Start free</a>
    </div>

    <button class="menu-btn" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
  </div>

  <div class="mobile" id="mobile-menu" hidden>
    <div class="container mobile-inner">
      {links.map((l) => (
        <a href={l.href}>{l.label}</a>
      ))}
      <a href="https://app.ottopay.pro/auth">Log in</a>
      <a class="btn btn-primary" href="https://app.ottopay.pro/auth?mode=signup">Start free</a>
    </div>
  </div>
</header>

<script>
  const btn = document.querySelector('.menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    btn.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
    if (menu) menu.hidden = open;
  });
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    gap: 28px;
    min-height: 68px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.35rem;
    letter-spacing: -0.02em;
  }
  .brand img {
    height: 28px;
    width: auto;
  }
  .links {
    display: none;
    gap: 22px;
    margin-left: 12px;
  }
  .links a {
    color: var(--ink-2);
    text-decoration: none;
    font-weight: 500;
    padding: 6px 0;
    border-bottom: 2px solid transparent;
  }
  .links a:hover,
  .links a[aria-current='page'] {
    color: var(--ink);
    border-bottom-color: var(--brand);
  }
  .actions {
    display: none;
    margin-left: auto;
    align-items: center;
    gap: 18px;
  }
  .login {
    color: var(--ink);
    text-decoration: none;
    font-weight: 500;
  }
  .btn-nav {
    min-height: 42px;
    padding: 0 18px;
    font-size: 0.95rem;
  }
  .menu-btn {
    margin-left: auto;
    background: none;
    border: 0;
    padding: 8px;
    color: var(--ink);
    cursor: pointer;
  }
  .mobile {
    border-top: 1px solid var(--line);
    background: var(--paper);
  }
  .mobile-inner {
    display: grid;
    gap: 4px;
    padding-top: 12px;
    padding-bottom: 20px;
  }
  .mobile-inner a {
    text-decoration: none;
    color: var(--ink);
    font-size: 1.15rem;
    font-weight: 500;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
  }
  .mobile-inner .btn {
    margin-top: 12px;
    border-bottom: 0;
    font-size: 1.02rem;
  }
  @media (min-width: 900px) {
    .links,
    .actions {
      display: flex;
    }
    .menu-btn,
    .mobile {
      display: none;
    }
  }
</style>
