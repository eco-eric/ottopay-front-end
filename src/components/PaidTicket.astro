---
// The one piece of motion on the site: an invoice goes from sent to paid.
interface Props {
  amount?: string;
  job?: string;
  number?: string;
}
const { amount = '$1,850.00', job = 'Condenser replacement', number = '1047' } = Astro.props;
---

<div class="ticket" role="img" aria-label={`Invoice ${number}, ${job}, ${amount}: sent 4:12 PM, viewed 4:14 PM, paid 4:19 PM`}>
  <div class="ticket-head">
    <span class="ticket-no">Invoice #{number}</span>
    <span class="ticket-amt">{amount}</span>
  </div>
  <div class="ticket-job">{job}</div>
  <ol class="ticket-steps">
    <li class="done"><span>Sent by text</span><time>4:12 PM</time></li>
    <li class="done"><span>Customer opened it</span><time>4:14 PM</time></li>
    <li class="paid"><span>Paid by card</span><time>4:19 PM</time></li>
  </ol>
  <div class="stamp" aria-hidden="true">Paid</div>
</div>

<style>
  .ticket {
    position: relative;
    background: var(--white);
    color: var(--ink);
    border-radius: var(--radius-m);
    padding: 18px 20px 58px;
    width: min(100%, 340px);
    box-shadow: 0 20px 50px rgba(21, 32, 28, 0.28);
    font-size: 0.95rem;
    overflow: hidden;
  }
  .ticket::after {
    /* torn receipt edge */
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 8px;
    background: radial-gradient(circle at 6px 8px, transparent 5px, var(--white) 5.5px) 0 0 / 12px 8px repeat-x;
    transform: rotate(180deg);
    opacity: 0;
  }
  .ticket-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }
  .ticket-no {
    color: var(--ink-3);
    font-weight: 500;
  }
  .ticket-amt {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.5rem;
    letter-spacing: -0.02em;
  }
  .ticket-job {
    font-weight: 600;
    margin: 2px 0 14px;
  }
  .ticket-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .ticket-steps li {
    display: grid;
    grid-template-columns: 18px 1fr auto;
    gap: 10px;
    align-items: center;
    color: var(--ink-2);
  }
  .ticket-steps li::before {
    content: '';
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 2px solid var(--line-2);
    margin-left: 2px;
  }
  .ticket-steps li.done::before {
    background: var(--brand);
    border-color: var(--brand);
  }
  .ticket-steps li.paid {
    color: var(--brand-deep);
    font-weight: 600;
  }
  .ticket-steps li.paid::before {
    background: var(--brand);
    border-color: var(--brand);
    animation: pop 500ms 1.4s both;
  }
  .ticket-steps time {
    font-variant-numeric: tabular-nums;
    color: var(--ink-3);
  }
  .stamp {
    position: absolute;
    right: 18px;
    bottom: 10px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand);
    border: 3px solid var(--brand);
    border-radius: 6px;
    padding: 2px 10px;
    transform: rotate(-12deg) scale(1);
    opacity: 0.92;
    mix-blend-mode: multiply;
    animation: stamp 420ms 1.6s cubic-bezier(0.2, 1.4, 0.4, 1) both;
  }
  @keyframes stamp {
    from {
      transform: rotate(-12deg) scale(2.2);
      opacity: 0;
    }
    to {
      transform: rotate(-12deg) scale(1);
      opacity: 0.92;
    }
  }
  @keyframes pop {
    from {
      transform: scale(0.4);
      background: var(--line-2);
      border-color: var(--line-2);
    }
    to {
      transform: scale(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .stamp,
    .ticket-steps li.paid::before {
      animation: none;
    }
  }
</style>
